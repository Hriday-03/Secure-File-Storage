# Application
APP_NAME=Secure File Storage API
APP_VERSION=0.1.0
APP_DESCRIPTION=Store files securely with AES-256-GCM encryption.
DEBUG=false

# API
API_PREFIX=/api

# Database
DATABASE_URL=sqlite:///./secure_storage.db

# Authentication (change SECRET_KEY in production!)
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Cryptography
RSA_KEY_SIZE=2048

# Storage
STORAGE_PATH=storage/encrypted_files
MAX_UPLOAD_SIZE_MB=100

# CORS (comma-separated list)
CORS_ORIGINS=http://localhost:5173

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
